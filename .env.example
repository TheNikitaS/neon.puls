# Скопируйте в .env и заполните. Файл .env в .gitignore.

# PostgreSQL. Формат: postgresql://user:password@host:5432/dbname
# Приложение само приведёт его к драйверу psycopg.
DATABASE_URL=

# Случайная строка 48+ символов
NEONPULSE_SECRET=

# 1 — демо-данные и sandbox-коннекторы, 0 — реальные интеграции
NEONPULSE_SANDBOX=1

# rules — детерминированное ядро, yandexgpt — Yandex Cloud Foundation Models
NEONPULSE_LLM_PROVIDER=rules
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
YANDEX_MODEL=yandexgpt-lite
